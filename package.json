{
  "name": "civic-air-quality-briefing-studio",
  "version": "1.0.0",
  "description": "Civic Air Quality Briefing Studio - Award-winning, production-grade civic intelligence platform for Hack2Skill Build with AI.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "test": "node test.js",
    "lint": "node scripts/lint.js",
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');const m={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json','.svg':'image/svg+xml'};http.createServer((req,res)=>{let f=req.url==='/'?'index.html':req.url.replace(/^\\//,'');let p=path.join(__dirname,f);if(fs.existsSync(p)&&fs.statSync(p).isFile()){res.writeHead(200,{'Content-Type':m[path.extname(p)]||'text/plain'});fs.createReadStream(p).pipe(res);}else{res.writeHead(404);res.end('Not Found');}}).listen(3000,()=>console.log('Briefing Studio live at http://localhost:3000'));\""
  },
  "keywords": [
    "air-quality",
    "aqi",
    "civic-tech",
    "hack2skill",
    "gemini-ai",
    "public-health",
    "environmental-governance"
  ],
  "author": "Google Developer Expert & Civic Architect",
  "license": "MIT"
}
